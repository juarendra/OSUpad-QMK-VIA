@@ -386,7 +386,36 @@ OSAL_IRQ_HANDLER(STM32_USB1_LP_HANDLER) {
 
   /* Reading interrupt sources and atomically clearing them.*/
   istr = STM32_USB->ISTR;
+#if defined(OSUPAD_CLONE_USB_ISTR_WORKAROUND)
+  /*
+   * F103-compatible clones have been observed to lose an EP0 SETUP event
+   * when all ISTR flags are cleared in one write.  The libmaple USB stack
+   * that enumerates correctly on the same board clears each non-CTR source
+   * explicitly and leaves CTR for the endpoint handler.  Preserve that
+   * sequence here; on genuine STM32F1 this is equivalent to the standard
+   * implementation.
+   */
+  if ((istr & ISTR_RESET) != 0U) {
+    STM32_USB->ISTR = ~ISTR_RESET;
+  }
+  if ((istr & ISTR_PMAOVR) != 0U) {
+    STM32_USB->ISTR = ~ISTR_PMAOVR;
+  }
+  if ((istr & ISTR_ERR) != 0U) {
+    STM32_USB->ISTR = ~ISTR_ERR;
+  }
+  if ((istr & ISTR_WKUP) != 0U) {
+    STM32_USB->ISTR = ~(ISTR_WKUP | ISTR_SUSP);
+  }
+  if ((istr & ISTR_SUSP) != 0U) {
+    STM32_USB->ISTR = ~(ISTR_WKUP | ISTR_SUSP);
+  }
+  if ((istr & ISTR_SOF) != 0U) {
+    STM32_USB->ISTR = ~ISTR_SOF;
+  }
+#else
   STM32_USB->ISTR = ~istr;
+#endif
 
