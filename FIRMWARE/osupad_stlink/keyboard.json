{
    "manufacturer": "positron_electronic",
    "keyboard_name": "osupad_stlink",
    "maintainer": "juarendra",
    "url": "https://www.tokopedia.com/positronelectronic",
    "processor": "STM32F103",
    "bootloader": "custom",
    "board": "OSUPAD_STLINK",
    "bootloader_instructions": "Flash through ST-Link/SWD at address 0x08000000.",
    "build": {
        "lto": true
    },
    "debounce": 5,
    "dynamic_keymap": {
        "layer_count": 4
    },
    "features": {
        "bootmagic": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": true
    },
    "host": {
        "default": {
            "nkro": true
        }
    },
    "matrix_pins": {
        "direct": [
            ["B0", "A7", "A6"],
            ["B12", "B13", "B14"]
        ]
    },
    "rgblight": {
        "animations": {
            "alternating": true,
            "breathing": true,
            "christmas": true,
            "knight": true,
            "rainbow_mood": true,
            "rainbow_swirl": true,
            "rgb_test": true,
            "snake": true,
            "static_gradient": true
        },
        "default": {
            "animation": "rainbow_swirl"
        },
        "driver": "ws2812",
        "led_count": 8
    },
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x1000",
        "vid": "0x7877"
    },
    "ws2812": {
        "pin": "A5"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1}
            ]
        }
    }
}
